{
  "name": "habitflow",
  "version": "0.1.0",
  "description": "Sistema de Gestão de Hábitos e Produtividade Pessoal com SDLC profissional no GitHub",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "habitflow": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js list",
