    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.js"
  },
  "keywords": [
    "habit-tracker",
    "sdlc",
    "clean-architecture",
    "git-flow",
    "github-issues",
    "streaks",
    "senac"
  ],
